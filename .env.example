# Server-side only. Never prefix these with VITE_ (that would expose them to the client).
XAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ground compiler model and reasoning effort (low | medium | high)
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
# Optional: Imagine model for escalation scene reconstructions
XAI_IMAGE_MODEL=grok-imagine-image-2.0

PORT=3001
