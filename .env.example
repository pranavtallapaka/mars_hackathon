# Server-side only. Never prefix these with VITE_ (that would expose them to the client).
XAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ground compiler model and reasoning effort (low | medium | high)
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
# Optional: Imagine model for escalation scene reconstructions
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional: ElevenLabs voices and models (defaults are premade Rachel / Adam + Flash / Scribe v2)
# ELEVENLABS_GROUND_VOICE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_ROVER_VOICE=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

PORT=3001
