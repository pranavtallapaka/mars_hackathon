# Server-side only. Never prefix these with VITE_ (that would expose them to the client).
XAI_API_KEY=
ELEVENLABS_API_KEY=

# Optional: ground compiler model and reasoning effort (low | medium | high)
XAI_MODEL=grok-4.7
XAI_REASONING_EFFORT=low
# Optional: Imagine model for escalation scene reconstructions
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional: ElevenLabs voices and models (defaults are premade Rachel / Adam + Flash / Scribe v2)
# ELEVENLABS_GROUND_VOICE=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_ROVER_VOICE=pNInz6obpgDQGcFmaJgB
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_STT_MODEL=scribe_v2

PORT=3001

# SpacetimeDB (server writes). Local default; Maincloud is wss://maincloud.spacetimedb.com
SPACETIMEDB_URI=ws://127.0.0.1:3000
SPACETIMEDB_DB_NAME=pranavtallapaka
# Optional: connect by identity instead of name
# SPACETIMEDB_DB_ID=c20008da0ca952acc53e1f8471c65d418d0b4d7f8a2b84e3fad4fe0196b4de76
# Optional: reuse a saved identity token
# SPACETIMEDB_TOKEN=
