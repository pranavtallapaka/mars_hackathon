{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.server.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": ["server", "shared", "vite.config.ts", "client/src/module_bindings", "client/src/sim"],
  "exclude": ["client/src/sim/**/*.test.ts"]
}
